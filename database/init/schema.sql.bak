CREATE TABLE "Roles" (
  "RoleID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "RoleName" VARCHAR NOT NULL,
  "Description" TEXT,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE "BookingStatuses" (
  "StatusID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "StatusName" VARCHAR NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE "EventCategories" (
  "CategoryID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "CategoryName" VARCHAR NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE "SeatTypes" (
  "SeatTypeID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "TypeName" VARCHAR NOT NULL,
  "PriceModifier" DECIMAL NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "seat_type_modifier_positive" CHECK ("PriceModifier" > 0)
);

CREATE TABLE "Users" (
  "UserID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "RoleID" INT NOT NULL DEFAULT 3,
  "FullName" VARCHAR NOT NULL,
  "Email" VARCHAR NOT NULL UNIQUE,
  "Password" VARCHAR NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "Users_RoleID_fkey"
    FOREIGN KEY ("RoleID") REFERENCES "Roles"("RoleID")
    ON DELETE SET DEFAULT ON UPDATE CASCADE
);

CREATE TABLE "Venues" (
  "VenueID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "VenueName" VARCHAR NOT NULL,
  "Location" TEXT,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE "Events" (
  "EventID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "CategoryID" INT NOT NULL,
  "Title" VARCHAR NOT NULL,
  "Description" TEXT,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "Events_CategoryID_fkey"
    FOREIGN KEY ("CategoryID") REFERENCES "EventCategories"("CategoryID")
    ON DELETE RESTRICT ON UPDATE CASCADE
);

CREATE TABLE "Seats" (
  "SeatID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "VenueID" INT NOT NULL,
  "SeatTypeID" INT NOT NULL,
  "RowLabel" VARCHAR NOT NULL,
  "SeatNumber" VARCHAR NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "Seats_VenueID_fkey"
    FOREIGN KEY ("VenueID") REFERENCES "Venues"("VenueID")
    ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT "Seats_SeatTypeID_fkey"
    FOREIGN KEY ("SeatTypeID") REFERENCES "SeatTypes"("SeatTypeID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "unique_seat_position" UNIQUE ("VenueID", "RowLabel", "SeatNumber")
);

CREATE TABLE "Showtimes" (
  "ShowtimeID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "EventID" INT NOT NULL,
  "VenueID" INT NOT NULL,
  "StartDateTime" TIMESTAMP NOT NULL,
  "BasePrice" DECIMAL NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "Showtimes_EventID_fkey"
    FOREIGN KEY ("EventID") REFERENCES "Events"("EventID")
    ON DELETE CASCADE ON UPDATE CASCADE,
  CONSTRAINT "Showtimes_VenueID_fkey"
    FOREIGN KEY ("VenueID") REFERENCES "Venues"("VenueID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "showtime_base_price_positive" CHECK ("BasePrice" >= 0)
);

CREATE TABLE "Bookings" (
  "BookingID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "UserID" INT NOT NULL,
  "StatusID" INT NOT NULL DEFAULT 1,
  "BookingTimestamp" TIMESTAMP NOT NULL DEFAULT NOW(),
  "ExpiresAt" TIMESTAMP NOT NULL,
  "TotalAmount" DECIMAL NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "Bookings_UserID_fkey"
    FOREIGN KEY ("UserID") REFERENCES "Users"("UserID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "Bookings_StatusID_fkey"
    FOREIGN KEY ("StatusID") REFERENCES "BookingStatuses"("StatusID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "booking_total_positive" CHECK ("TotalAmount" >= 0),
  CONSTRAINT "booking_expires_after_created" CHECK ("ExpiresAt" > "BookingTimestamp")
);

CREATE TABLE "PaymentMethods" (
  "MethodID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "MethodName" VARCHAR NOT NULL,
  "IsActive" BOOLEAN NOT NULL DEFAULT TRUE,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE "BookingDetails" (
  "DetailID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "BookingID" INT NOT NULL,
  "ShowtimeID" INT NOT NULL,
  "SeatID" INT NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "BookingDetails_BookingID_fkey"
    FOREIGN KEY ("BookingID") REFERENCES "Bookings"("BookingID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "BookingDetails_ShowtimeID_fkey"
    FOREIGN KEY ("ShowtimeID") REFERENCES "Showtimes"("ShowtimeID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "BookingDetails_SeatID_fkey"
    FOREIGN KEY ("SeatID") REFERENCES "Seats"("SeatID")
    ON DELETE RESTRICT ON UPDATE CASCADE
);

CREATE TABLE "PaymentStatuses" (
  "StatusID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "StatusName" VARCHAR NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW()
);

CREATE TABLE "Payments" (
  "PaymentID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "BookingID" INT NOT NULL UNIQUE,
  "MethodID" INT NOT NULL,
  "StatusID" INT NOT NULL DEFAULT 1,
  "TransactionID" VARCHAR NOT NULL UNIQUE,
  "Amount" DECIMAL NOT NULL,
  "PaidAt" TIMESTAMP,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "Payments_BookingID_fkey"
    FOREIGN KEY ("BookingID") REFERENCES "Bookings"("BookingID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "Payments_MethodID_fkey"
    FOREIGN KEY ("MethodID") REFERENCES "PaymentMethods"("MethodID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "Payments_StatusID_fkey"
    FOREIGN KEY ("StatusID") REFERENCES "PaymentStatuses"("StatusID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "payment_amount_positive" CHECK ("Amount" >= 0)
);

CREATE TABLE "Tickets" (
  "TicketID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "TicketNo" VARCHAR(20) NOT NULL UNIQUE,
  "DetailID" INT NOT NULL UNIQUE,
  "FinalPrice" DECIMAL(10, 2) NOT NULL,
  "CreatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  "UpdatedAt" TIMESTAMP NOT NULL DEFAULT NOW(),
  CONSTRAINT "Tickets_DetailID_fkey"
    FOREIGN KEY ("DetailID") REFERENCES "BookingDetails"("DetailID")
    ON DELETE RESTRICT ON UPDATE CASCADE,
  CONSTRAINT "ticket_price_positive" CHECK ("FinalPrice" >= 0)
);

COMMENT ON COLUMN "Roles"."RoleName" IS 'Admin, Customer, Staff';
COMMENT ON COLUMN "BookingStatuses"."StatusName" IS 'Pending, Completed, Cancelled';
COMMENT ON COLUMN "EventCategories"."CategoryName" IS 'Movie, Concert, Seminar';
COMMENT ON COLUMN "SeatTypes"."TypeName" IS 'VIP, Standard, Sofa Bed';
COMMENT ON COLUMN "Bookings"."ExpiresAt" IS 'Session Timeout';
COMMENT ON COLUMN "PaymentMethods"."MethodName" IS 'PromptPay, Credit Card, TrueMoney, ShopeePay';
COMMENT ON COLUMN "PaymentStatuses"."StatusName" IS 'Pending, Success, Failed';
COMMENT ON COLUMN "Payments"."TransactionID" IS 'Gateway reference code';

CREATE OR REPLACE VIEW "ShowtimeAvailableSeats" AS
SELECT
  sh."ShowtimeID",
  sh."EventID",
  sh."VenueID",
  sh."StartDateTime",
  s."SeatID",
  s."RowLabel",
  s."SeatNumber",
  st."SeatTypeID",
  st."TypeName" AS "SeatTypeName",
  sh."BasePrice",
  st."PriceModifier",
  (sh."BasePrice" * st."PriceModifier")::DECIMAL(10, 2) AS "CalculatedPrice",
  NOT EXISTS (
    SELECT 1
    FROM "BookingDetails" bd
    JOIN "Bookings" b ON b."BookingID" = bd."BookingID"
    JOIN "BookingStatuses" bs ON bs."StatusID" = b."StatusID"
    WHERE bd."ShowtimeID" = sh."ShowtimeID"
      AND bd."SeatID" = s."SeatID"
      AND (
        bs."StatusName" = 'Completed'
        OR (
          bs."StatusName" = 'Pending'
          AND b."ExpiresAt" > NOW()
        )
      )
  ) AS "IsAvailable"
FROM "Showtimes" sh
JOIN "Seats" s ON s."VenueID" = sh."VenueID"
JOIN "SeatTypes" st ON st."SeatTypeID" = s."SeatTypeID";
