CREATE TABLE "Roles" (
  "RoleID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "RoleName" varchar,
  "Description" text
);

CREATE TABLE "BookingStatuses" (
  "StatusID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "StatusName" varchar
);

CREATE TABLE "EventCategories" (
  "CategoryID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "CategoryName" varchar
);

CREATE TABLE "SeatTypes" (
  "SeatTypeID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "TypeName" varchar,
  "PriceModifier" decimal
);

CREATE TABLE "Users" (
  "UserID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "RoleID" int,
  "FullName" varchar,
  "Email" varchar UNIQUE,
  "Password" varchar
);

CREATE TABLE "Venues" (
  "VenueID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "VenueName" varchar,
  "Location" text
);

CREATE TABLE "Events" (
  "EventID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "CategoryID" int,
  "Title" varchar,
  "Description" text
);

CREATE TABLE "Seats" (
  "SeatID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "VenueID" int,
  "SeatTypeID" int,
  "RowLabel" varchar,
  "SeatNumber" varchar
);

CREATE TABLE "Showtimes" (
  "ShowtimeID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "EventID" int,
  "VenueID" int,
  "StartDateTime" timestamp,
  "BasePrice" decimal
);

CREATE TABLE "Bookings" (
  "BookingID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "UserID" int,
  "StatusID" int,
  "BookingTimestamp" timestamp,
  "ExpiresAt" timestamp,
  "TotalAmount" decimal
);

CREATE TABLE "PaymentMethods" (
  "MethodID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "MethodName" varchar,
  "IsActive" boolean DEFAULT true
);

CREATE TABLE "BookingDetails" (
  "DetailID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "BookingID" int,
  "ShowtimeID" int,
  "SeatID" int
);

CREATE TABLE "PaymentStatuses" (
  "StatusID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "StatusName" varchar
);

CREATE TABLE "Payments" (
  "PaymentID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "BookingID" int UNIQUE,
  "MethodID" int,
  "StatusID" int,
  "TransactionID" varchar UNIQUE,
  "Amount" decimal,
  "PaidAt" timestamp
);

CREATE TABLE "Tickets" (
  "TicketID" INT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
  "TicketNo" varchar(20) UNIQUE,
  "DetailID" int UNIQUE,
  "FinalPrice" decimal(10,2)
);

CREATE UNIQUE INDEX "unique_pending_seat" ON "BookingDetails" ("ShowtimeID", "SeatID");

COMMENT ON COLUMN "Roles"."RoleName" IS 'Admin, Customer, Staff';

COMMENT ON COLUMN "BookingStatuses"."StatusName" IS 'Pending, Completed, Cancelled';

COMMENT ON COLUMN "EventCategories"."CategoryName" IS 'Movie, Concert, Seminar';

COMMENT ON COLUMN "SeatTypes"."TypeName" IS 'VIP, Standard, Sofa Bed';

COMMENT ON COLUMN "Bookings"."ExpiresAt" IS 'Session Timeout';

COMMENT ON COLUMN "PaymentMethods"."MethodName" IS 'PromptPay, Credit Card, TrueMoney, ShopeePay';

COMMENT ON COLUMN "PaymentStatuses"."StatusName" IS 'Pending, Success, Failed, Refunded';

COMMENT ON COLUMN "Payments"."TransactionID" IS 'รหัสอ้างอิงจาก Gateway';

ALTER TABLE "Users" ADD FOREIGN KEY ("RoleID") REFERENCES "Roles" ("RoleID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Events" ADD FOREIGN KEY ("CategoryID") REFERENCES "EventCategories" ("CategoryID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Seats" ADD FOREIGN KEY ("VenueID") REFERENCES "Venues" ("VenueID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Seats" ADD FOREIGN KEY ("SeatTypeID") REFERENCES "SeatTypes" ("SeatTypeID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Showtimes" ADD FOREIGN KEY ("EventID") REFERENCES "Events" ("EventID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Showtimes" ADD FOREIGN KEY ("VenueID") REFERENCES "Venues" ("VenueID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Bookings" ADD FOREIGN KEY ("UserID") REFERENCES "Users" ("UserID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Bookings" ADD FOREIGN KEY ("StatusID") REFERENCES "BookingStatuses" ("StatusID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "BookingDetails" ADD FOREIGN KEY ("BookingID") REFERENCES "Bookings" ("BookingID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "BookingDetails" ADD FOREIGN KEY ("ShowtimeID") REFERENCES "Showtimes" ("ShowtimeID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "BookingDetails" ADD FOREIGN KEY ("SeatID") REFERENCES "Seats" ("SeatID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Payments" ADD FOREIGN KEY ("BookingID") REFERENCES "Bookings" ("BookingID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Payments" ADD FOREIGN KEY ("MethodID") REFERENCES "PaymentMethods" ("MethodID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Payments" ADD FOREIGN KEY ("StatusID") REFERENCES "PaymentStatuses" ("StatusID") DEFERRABLE INITIALLY IMMEDIATE;

ALTER TABLE "Tickets" ADD FOREIGN KEY ("DetailID") REFERENCES "BookingDetails" ("DetailID") DEFERRABLE INITIALLY IMMEDIATE;
