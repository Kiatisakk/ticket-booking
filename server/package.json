{
  "name": "server",
  "version": "1.0.0",
  "description": "Ticket Booking API Server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:apply-constraints": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/check_constraints.sql",
    "db:cleanup-strict": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/strict_requirement_cleanup.sql",
    "db:optimize-indexes": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/performance_indexes.sql",
    "db:drop-indexes": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/drop_performance_indexes.sql",
    "db:optimize-reports": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/report_materialized_views.sql",
    "db:refresh-report-views": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/refresh_report_materialized_views.sql",
    "db:drop-report-views": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/drop_report_materialized_views.sql",
    "db:seed": "node prisma/seed.js",
    "db:seed-historical": "node src/seed-historical.js",
    "db:seed-big": "node src/seed-big-data.js",
    "db:seed-synthetic-py": "python scripts/synthetic_seed.py",
    "db:benchmark": "node src/benchmark-db.js",
    "db:benchmark:baseline": "node src/benchmark-db.js --save-baseline",
    "db:benchmark:compare": "node src/benchmark-db.js --compare",
    "db:benchmark:ab": "node src/benchmark-db.js --ab",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "@prisma/client": "^6.19.0",
    "bcrypt": "^6.0.0",
    "cors": "^2.8.6",
    "dotenv": "^17.4.1",
    "express": "^5.2.1",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.14",
    "prisma": "^6.19.0"
  }
}
