{
  "name": "server",
  "version": "1.0.0",
  "description": "Ticket Booking API Server",
  "main": "index.js",
  "scripts": {
    "start": "node index.js",
    "dev": "nodemon index.js",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:apply-constraints": "prisma db execute --schema prisma/schema.prisma --file prisma/migrations/check_constraints.sql",
    "db:seed": "node prisma/seed.js",
    "db:seed-historical": "node src/seed-historical.js",
    "test": "node --test \"test/**/*.test.js\""
  },
  "keywords": [],
  "author": "",
